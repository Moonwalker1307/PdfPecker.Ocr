<Project Sdk="Microsoft.NET.Sdk">

  <!-- Generates the synthetic OCR corpus with ground truth that bench/TesseractComparison measures; see README.md. The
       pages are drawn by the PdfPecker release the package depends on, so the corpus is the same on every machine. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>Corpus</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PdfPecker" Version="$(PdfPeckerVersion)" />
  </ItemGroup>

</Project>
